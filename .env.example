# Development defaults. Change POSTGRES_PASSWORD before an exposed deployment.
POSTGRES_DB=sherlock
POSTGRES_USER=sherlock
POSTGRES_PASSWORD=sherlock
POSTGRES_PORT=5432

# PostgreSQL URL used by host-run polling commands and Alembic.
DATABASE_URL=postgresql+psycopg://sherlock:sherlock@localhost:5432/sherlock

# Regional Vinted origin used by the anonymous catalog client (for example .es).
VINTED_BASE_URL=https://www.vinted.es

# Optional. Keep this secret; Sherlock only logs whether it is configured.
DISCORD_WEBHOOK_URL=

# Long-running watcher settings. Numeric values must be positive; per-page is 1-96.
WATCH_INTERVAL_SECONDS=3600
WATCH_PAGES=3
WATCH_PER_PAGE=48
WATCH_WATCHES_ONLY=true
