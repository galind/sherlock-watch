# PostgreSQL URL used by the CLI and Alembic.
DATABASE_URL=postgresql+psycopg://sherlock:sherlock@localhost:5432/sherlock

# Use the App ID and Cert ID from one eBay developer keyset.
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id

# production searches live listings; sandbox has limited/mock search data.
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
