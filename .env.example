# PostgreSQL URL used by the polling command and Alembic.
DATABASE_URL=postgresql+psycopg://sherlock:sherlock@localhost:5432/sherlock

# Regional Vinted origin used by the anonymous catalog client.
VINTED_BASE_URL=https://www.vinted.es

# Optional Discord webhook for watch-vinted new-listing notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/example-id/example-token
